# Environment variables for the API. Export them (or configure them in your IDE / host) before starting.
SERVER_PORT=8080
# Full connection string (optional). Without it the API uses localhost:27017.
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/ajp_fighter_os
MONGODB_DATABASE=ajp_fighter_os
# Base64, at least 256 bits. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=7d
CORS_ALLOWED_ORIGINS=http://localhost:5173
